// Prisma Schema для Telegram WebApp проекта
// Поддержка PostgreSQL и SQLite (fallback)
//
// Автоматическое определение провайдера:
// - Если DATABASE_URL начинается с "postgresql://" или "postgres://" → PostgreSQL
// - Если DATABASE_URL начинается с "file:" или не установлен → SQLite (file:./dev.db)
//
// Для SQLite (fallback):
//   DATABASE_URL="file:./dev.db"
//
// Для PostgreSQL:
//   DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

generator client {
  provider = "prisma-client-js"
}

// SQLite используется как fallback, если DATABASE_URL не указывает на PostgreSQL
// Для определения провайдера используется скрипт scripts/detect-db-provider.js
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

/// Роли пользователей в системе
/// - guest: неавторизованный пользователь (не хранится в БД)
/// - user: обычный пользователь
/// - admin: администратор
/// - superadmin: суперадминистратор
enum Role {
  user
  admin
  superadmin
}

/// Статус одобрения пользователя
enum AccessStatus {
  pending    // Ожидает одобрения
  approved   // Одобрен
  rejected   // Отклонен
}

// ============================================
// MODELS
// ============================================

/// Пользователи Telegram WebApp
/// 
/// Основная таблица для хранения данных пользователей из Telegram.
/// Telegram ID используется как первичный ключ (bigint).
model User {
  /// Telegram User ID (используется как PK)
  /// SQLite: хранится как String (Telegram ID может быть очень большим)
  /// PostgreSQL: хранится как BigInt
  id          String   @id @default("")
  
  /// Telegram username (может быть null)
  username    String?
  
  /// Имя пользователя из Telegram
  firstName   String   @map("first_name")
  
  /// Фамилия пользователя из Telegram (может быть null)
  lastName    String?  @map("last_name")
  
  /// URL фото профиля из Telegram (может быть null)
  photoUrl    String?  @map("photo_url")
  
  /// Роль пользователя в системе
  role        Role     @default(user)
  
  /// Заблокирован ли пользователь
  isBlocked   Boolean  @default(false) @map("is_blocked")
  
  /// Дата создания записи
  createdAt   DateTime @default(now()) @map("created_at")
  
  /// Дата последнего обновления
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  /// Дата последнего входа
  lastLoginAt DateTime? @map("last_login_at")
  
  /// Статус доступа пользователя
  accessStatus AccessStatus @default(pending) @map("access_status")
  
  /// ID начального курса (с какого курса пользователь начинает обучение)
  startCourseId Int? @map("start_course_id")
  
  /// Дата одобрения доступа
  approvedAt DateTime? @map("approved_at")
  
  /// ID администратора, который одобрил доступ
  approvedBy String? @map("approved_by")
  
  // Relations
  logs        Log[]
  progress    UserProgress[]
  accessRequests AccessRequest[]
  startCourse Course? @relation("UserStartCourse", fields: [startCourseId], references: [id], onDelete: SetNull)
  
  @@map("users")
  @@index([role], name: "idx_users_role")
  @@index([isBlocked], name: "idx_users_is_blocked")
  @@index([lastLoginAt], name: "idx_users_last_login_at")
  @@index([accessStatus], name: "idx_users_access_status")
  @@index([startCourseId], name: "idx_users_start_course_id")
}

/// Логи действий пользователей и администраторов (Audit Trail)
/// 
/// Таблица для логирования всех действий в системе.
/// Используется для аудита и отладки.
model Log {
  /// ID лога (автоинкремент)
  id        Int      @id @default(autoincrement())
  
  /// ID пользователя, выполнившего действие (nullable для системных действий)
  /// SQLite: хранится как String
  /// PostgreSQL: хранится как String (совместимо с User.id)
  userId    String?  @map("user_id")
  
  /// Роль пользователя на момент действия
  role      Role
  
  /// Тип действия (например: "user.created", "admin.access")
  action    String
  
  /// Тип сущности, над которой выполнено действие (например: "user", "settings")
  entity    String?
  
  /// ID сущности, над которой выполнено действие
  entityId  String?  @map("entity_id")
  
  /// IP адрес пользователя
  ip        String   // IPv6 может быть до 45 символов
  
  /// User Agent браузера
  userAgent String   @map("user_agent")
  
  /// Дополнительные метаданные в формате JSON
  /// SQLite: хранится как Text (JSON string)
  /// PostgreSQL: хранится как Json
  meta      String?
  
  /// Дата создания лога
  createdAt DateTime @default(now()) @map("created_at")
  
  // Relations
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@map("logs")
  @@index([userId], name: "idx_logs_user_id")
  @@index([action], name: "idx_logs_action")
  @@index([entity, entityId], name: "idx_logs_entity")
  @@index([createdAt(sort: Desc)], name: "idx_logs_created_at")
  @@index([role], name: "idx_logs_role")
}

/// Направления обучения (например: "Тхэквондо для начинающих", "Спортивное тхэквондо")
model Direction {
  /// ID направления (автоинкремент)
  id          Int      @id @default(autoincrement())
  
  /// Название направления
  name        String
  
  /// Описание направления
  description String?
  
  /// Порядок отображения
  order       Int      @default(0)
  
  /// Активно ли направление
  isActive    Boolean  @default(true) @map("is_active")
  
  /// Дата создания
  createdAt   DateTime @default(now()) @map("created_at")
  
  /// Дата обновления
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  // Relations
  courses     Course[]
  
  @@map("directions")
  @@index([order], name: "idx_directions_order")
  @@index([isActive], name: "idx_directions_is_active")
}

/// Курсы в рамках направления
model Course {
  /// ID курса (автоинкремент)
  id          Int      @id @default(autoincrement())
  
  /// ID направления
  directionId Int      @map("direction_id")
  
  /// Название курса
  name        String
  
  /// Описание курса
  description String?
  
  /// Порядок отображения в рамках направления
  order       Int      @default(0)
  
  /// Активен ли курс
  isActive    Boolean  @default(true) @map("is_active")
  
  /// Дата создания
  createdAt   DateTime @default(now()) @map("created_at")
  
  /// Дата обновления
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  // Relations
  direction   Direction @relation(fields: [directionId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  userProgress UserProgress[]
  startCourseUsers User[] @relation("UserStartCourse")
  
  @@map("courses")
  @@index([directionId], name: "idx_courses_direction_id")
  @@index([order], name: "idx_courses_order")
  @@index([isActive], name: "idx_courses_is_active")
}

/// Уроки в рамках курса
model Lesson {
  /// ID урока (автоинкремент)
  id          Int      @id @default(autoincrement())
  
  /// ID курса
  courseId    Int      @map("course_id")
  
  /// Название урока
  name        String
  
  /// Описание урока
  description String?
  
  /// Содержимое урока (текст, HTML, markdown)
  content     String?
  
  /// Порядок отображения в рамках курса
  order       Int      @default(0)
  
  /// Активен ли урок
  isActive    Boolean  @default(true) @map("is_active")
  
  /// Дата создания
  createdAt   DateTime @default(now()) @map("created_at")
  
  /// Дата обновления
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  // Relations
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    UserProgress[]
  
  @@map("lessons")
  @@index([courseId], name: "idx_lessons_course_id")
  @@index([order], name: "idx_lessons_order")
  @@index([isActive], name: "idx_lessons_is_active")
}

/// Прогресс пользователя по урокам и курсам
model UserProgress {
  /// ID записи (автоинкремент)
  id          Int      @id @default(autoincrement())
  
  /// ID пользователя
  userId      String   @map("user_id")
  
  /// ID урока
  lessonId    Int      @map("lesson_id")
  
  /// Завершен ли урок
  isCompleted Boolean  @default(false) @map("is_completed")
  
  /// Дата начала прохождения
  startedAt   DateTime? @map("started_at")
  
  /// Дата завершения
  completedAt DateTime? @map("completed_at")
  
  /// Дата создания записи
  createdAt   DateTime @default(now()) @map("created_at")
  
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  @@map("user_progress")
  @@unique([userId, lessonId], name: "unique_user_lesson")
  @@index([userId], name: "idx_user_progress_user_id")
  @@index([lessonId], name: "idx_user_progress_lesson_id")
  @@index([isCompleted], name: "idx_user_progress_is_completed")
}

/// Запросы на доступ от пользователей
model AccessRequest {
  /// ID запроса (автоинкремент)
  id          Int      @id @default(autoincrement())
  
  /// ID пользователя, который запросил доступ
  userId      String   @map("user_id")
  
  /// Статус запроса
  status      AccessStatus @default(pending)
  
  /// Сообщение от пользователя (опционально)
  message     String?
  
  /// ID администратора, который обработал запрос
  processedBy String?  @map("processed_by")
  
  /// Дата обработки запроса
  processedAt DateTime? @map("processed_at")
  
  /// Комментарий администратора при обработке
  adminComment String? @map("admin_comment")
  
  /// Дата создания запроса
  createdAt   DateTime @default(now()) @map("created_at")
  
  /// Дата обновления
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("access_requests")
  @@index([userId], name: "idx_access_requests_user_id")
  @@index([status], name: "idx_access_requests_status")
  @@index([createdAt], name: "idx_access_requests_created_at")
}
