{
  "name": "taekwondo-school",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "node scripts/run-with-env.js \"npx prisma generate\" || true",
    "prisma:generate": "node scripts/run-with-env.js \"npx prisma generate\"",
    "prisma:migrate": "node scripts/run-with-env.js \"npx prisma migrate deploy\" || node scripts/run-with-env.js \"npx prisma db push\"",
    "migrate:deploy": "node scripts/run-with-env.js \"npx prisma migrate deploy\"",
    "migrate:dev": "node scripts/run-with-env.js \"npx prisma migrate dev\"",
    "migrate:generate": "node scripts/run-with-env.js \"npx prisma generate\"",
    "vercel-build": "node scripts/setup-database.js && npm run build",
    "db:setup": "node scripts/setup-database.js"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "next": "^14.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.0",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
